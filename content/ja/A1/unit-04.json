  "lessons": [
    {
      "id": "ja-a1-04.l1",
      "title": "Hot, cheap, big: い-adjectives",
      "canDo": "I can describe things with い-adjectives and say what they are not.",
      "intro": {
        "place": "cafe",
        "scene": "A café in Tokyo in July. Nakamura asks Leo how he is finding the city.",
        "lines": [
          {
            "who": "中村",
            "text": "レオさん、{東京|とうきょう}{は|wa}どうですか。",
            "meaning": "Leo, how do you find Tokyo?",
            "politeness": "polite"
          },
          {
            "who": "レオ",
            "text": "とても{楽|たの}しいです。でも、{暑|あつ}いですね。",
            "meaning": "It's a lot of fun. But it's hot, isn't it?",
            "politeness": "polite"
          },
          {
            "who": "中村",
            "text": "そうですね。ブラジルも{暑|あつ}いですか。",
            "meaning": "It is. Is Brazil hot too?",
            "politeness": "polite"
          },
          {
            "who": "レオ",
            "text": "はい。でも、わたしの{町|まち}{は|wa}あまり{暑|あつ}くないです。",
            "meaning": "Yes. But my town isn't very hot.",
            "politeness": "polite"
          },
          {
            "who": "中村",
            "text": "このコーヒー、おいしいですね。",
            "meaning": "This coffee is good, isn’t it?",
            "politeness": "polite"
          },
          {
            "who": "レオ",
            "text": "はい。でも、ちょっと{高|たか}いです。",
            "meaning": "Yes. But it's a bit expensive.",
            "politeness": "polite"
          }
        ],
        "notes": [
          {
            "title": "い-adjectives",
            "body": "They end in い and go straight before です: {暑|あつ}いです, {高|たか}いです. Before a noun they need nothing: {高|たか}いコーヒー."
          },
          {
            "title": "The negative: 〜くないです",
            "body": "Drop the last い and add くないです: {暑|あつ}い → {暑|あつ}くないです, {高|たか}い → {高|たか}くないです. One is irregular: いい → よくないです. Never use じゃありません with these."
          },
          {
            "title": "とても, ちょっと, あまり",
            "body": "とても = very. ちょっと = a bit. あまり only goes with a negative: あまり{暑|あつ}くないです, \"not very hot\". でも starts a sentence that says \"but\"."
          }
        ]
      },
