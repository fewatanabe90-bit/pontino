  "lessons": [
    {
      "id": "ja-t04.l1",
      "title": "A table for two",
      "canDo": "I can say how many we are and ask for an English menu.",
      "intro": {
        "art": "🏮🚪🍜",
        "scene": "Leo and Sato walk into a small restaurant near the station.",
        "lines": [
          {
            "who": "店員",
            "text": "いらっしゃいませ。{何名様|なんめいさま}ですか。",
            "meaning": "Welcome. How many in your party?",
            "politeness": "polite"
          },
          {
            "who": "レオ",
            "text": "{二人|ふたり}です。",
            "meaning": "Two.",
            "politeness": "polite"
          },
          {
            "who": "店員",
            "text": "こちら{へ|e}どうぞ。",
            "meaning": "This way, please.",
            "politeness": "polite"
          },
          {
            "who": "レオ",
            "text": "すみません、{英語|えいご}のメニュー{は|wa}ありますか。",
            "meaning": "Excuse me, do you have an English menu?",
            "politeness": "polite"
          },
          {
            "who": "店員",
            "text": "はい、あります。どうぞ。",
            "meaning": "Yes, we do. Here you are.",
            "politeness": "polite"
          },
          {
            "who": "店員",
            "text": "ご{注文|ちゅうもん}{は|wa}お{決|き}まりですか。",
            "meaning": "Have you decided on your order?",
            "politeness": "polite"
          },
          {
            "who": "レオ",
            "text": "ちょっと{待|ま}ってください。",
            "meaning": "Just a moment, please.",
            "politeness": "polite"
          }
        ],
        "notes": [
          {
            "title": "{何名様|なんめいさま}ですか",
            "body": "The first thing you hear in most restaurants. {名|めい} counts customers politely and {様|さま} is an honorific, so never use it for yourself: answer {一人|ひとり}です or {二人|ふたり}です. Holding up fingers works too."
          },
          {
            "title": "{英語|えいご}のメニュー",
            "body": "の links two nouns: an \"English menu\". Many places have one, or a menu with photos. If not, you will hear ありません or すみません."
          },
          {
            "title": "ご{注文|ちゅうもん}{は|wa}お{決|き}まりですか",
            "body": "Staff language for \"are you ready to order?\". Catch ご{注文|ちゅうもん} (order). If you need time: ちょっと{待|ま}ってください."
          }
        ]
      },
