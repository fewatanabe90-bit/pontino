  "lessons": [
    {
      "id": "ja-t01.l1",
      "title": "Where is it? どこですか",
      "canDo": "I can ask where something is and follow \"here, there, over there\".",
      "intro": {
        "art": "🛬🧳🚻",
        "scene": "Arrivals hall. Leo has his bag and needs two things: a toilet and the train.",
        "lines": [
          {
            "who": "レオ",
            "text": "すみません、{電車|でんしゃ}の{駅|えき}{は|wa}どこですか。",
            "meaning": "Excuse me, where is the train station?",
            "politeness": "polite"
          },
          {
            "who": "係員",
            "text": "{駅|えき}{は|wa}{地下|ちか}です。あそこのエスカレーターです。",
            "meaning": "The station is underground. It's that escalator over there.",
            "politeness": "polite"
          },
          {
            "who": "レオ",
            "text": "トイレ{は|wa}どこですか。",
            "meaning": "Where is the toilet?",
            "politeness": "polite"
          },
          {
            "who": "係員",
            "text": "トイレ{は|wa}そこです。",
            "meaning": "The toilet is right there, next to you.",
            "politeness": "polite"
          },
          {
            "who": "レオ",
            "text": "ありがとうございます。",
            "meaning": "Thank you.",
            "politeness": "polite"
          }
        ],
        "notes": [
          {
            "title": "〜{は|wa}どこですか",
            "body": "Name the thing, add {は|wa}どこですか. It is the single most useful question of the trip: {出口|でぐち}{は|wa}どこですか, トイレ{は|wa}どこですか."
          },
          {
            "title": "ここ・そこ・あそこ",
            "body": "The same three zones as これ・それ・あれ, but for places: ここ here by me, そこ there by you, あそこ over there, away from both of us. People usually point as they say it."
          },
          {
            "title": "Reading the two key signs",
            "body": "{出口|でぐち} is the exit and {入口|いりぐち} is the entrance. {口|くち} means \"mouth\": the mouth you go out of, the mouth you go into."
          }
        ]
      },
